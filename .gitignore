# --- Secrets and machine/server-specific configuration (never commit) ---
application/config/database.local.php
application/config/database.production.php
.env
.env.*
!.env.example

# --- Database dumps and backups (contain personal data) ---
*.sql
*.sql.gz
!uploads/install.sql
backups/*
!backups/.gitkeep

# --- Runtime data written by the application ---
application/logs/*
!application/logs/index.html
application/cache/*
!application/cache/index.html
application/storage/private/*

# --- Browser test tooling and output ---
e2e/node_modules/
e2e/.auth/
e2e/report/
e2e/test-results/
e2e/report-isolated/
e2e/playwright-report/
e2e/test-results-isolated/
e2e/report-studio/
e2e/test-results-studio/
tools/__pycache__/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

application/config/ha_publisher.local.php
application/config/ha_mobile.local.php
