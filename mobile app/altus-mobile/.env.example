EXPO_PUBLIC_PLATFORM_URL=https://altusgulf.com
# Optional: an app key (altm_...) from /hkp/admin/mobile. It only unlocks the public
# remote config (branding, toggles, versions) and is visible in the app binary by design.
# Never put personal API keys (ha_...) or signing secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_ALTUS_APP_KEY=
