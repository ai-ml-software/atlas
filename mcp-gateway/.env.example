HOST=127.0.0.1
PORT=3100
# Public HTTPS origin of this gateway (issuer + MCP resource = $ALTUS_MCP_URL/mcp)
ALTUS_MCP_URL=http://127.0.0.1:3100
ALTUS_NATIVE_URL=http://localhost/atlas/atlas
# Feature switch: must be 1 here AND in the PHP environment, or /mcp and the native API return 503.
ALTUS_MCP_ENABLED=1
# Shared HS256 secret for delegated (<=60s) native credentials. Same value in PHP. >=32 chars.
ALTUS_MCP_SECRET=
ALTUS_MCP_KEY_ID=2026-10
# Rotation window only: the previous secret and its key id still verify. Remove after rotation.
ALTUS_MCP_SECRET_PREVIOUS=
ALTUS_MCP_KEY_ID_PREVIOUS=
ALTUS_DB_HOST=127.0.0.1
ALTUS_DB_NAME=atlas_merged
ALTUS_DB_USER=root
ALTUS_DB_PASSWORD=
ALTUS_OAUTH_JWKS_FILE=private-jwks.json
# Comma-separated cookie signing keys (newest first). Defaults to a value derived from ALTUS_MCP_SECRET.
ALTUS_COOKIE_KEYS=
ALTUS_TRUST_PROXY=0
ALTUS_OAUTH_CLIENTS=[{"client_id":"altus-local","redirect_uris":["http://127.0.0.1:3200/callback"],"grant_types":["authorization_code","refresh_token"],"response_types":["code"],"token_endpoint_auth_method":"none"}]
