{
  "expo": {
    "name": "ALTUS Knowledge & Performance",
    "slug": "altus-knowledge-performance",
    "version": "1.2.2",
    "scheme": "altus",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altusgulf.knowledge",
      "buildNumber": "6",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan training attendance and certificate QR codes when you choose to scan.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.altusgulf.knowledge",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F7F5F1"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/altus-favicon.png"
    },
    "extra": {
      "platformUrl": "https://altusgulf.com",
      "supportsRTL": true
    },
    "plugins": [
      "expo-router",
      "./plugins/withReleaseSigning.cjs",
      "expo-font",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan training attendance and certificate QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#C45B2F"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/altus-mark.png",
          "imageWidth": 110,
          "backgroundColor": "#F7F5F1",
          "dark": {
            "image": "./assets/altus-mark.png",
            "backgroundColor": "#1C2227"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
