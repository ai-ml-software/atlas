{
    "name": "altus-hkp-e2e",
    "version": "1.0.0",
    "description": "Playwright end-to-end tests for altus HK&P (runs against local Laragon only)",
    "scripts": {
        "test": "playwright test",
        "test:desktop": "playwright test --project=desktop",
        "test:mobile": "playwright test --project=mobile",
        "test:isolated": "playwright test -c playwright.isolated.config.ts",
        "test:course-entry": "playwright test -c playwright.isolated.config.ts course-entry.spec.ts --project=desktop",
        "report": "playwright show-report report",
        "test:headed": "playwright test --project=desktop --headed",
        "guides": "playwright test -c playwright.guides.config.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs",
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "yaml": "^2.9.1"
    }
}
